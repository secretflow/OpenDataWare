        <maven.compiler.target>20</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <flink.version>2.1.0</flink.version>
        <com.alibaba.fastjson.version>2.0.59</com.alibaba.fastjson.version>
        <flink.connector.jdbc.version>3.3.0-1.20</flink.connector.jdbc.version>
        <org.junit.version>6.0.1</org.junit.version>
